{
  "schema": "tapt-exporter-recipe/1",
  "version": "0.18.0",
  "semantics": "locked-cli-and-process-writer-v1",
  "amd64_builder_image": "rust:1.95-slim-bookworm@sha256:6f9e63259f12e1e599296f5ecfed2bae46de4af0ee0525dd8b89c046e236d5c5",
  "cpus": "2",
