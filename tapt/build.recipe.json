    ["/work/vectorcraft", "test", "--locked", "-p", "vectorcraft-pdf", "tests::import_lines::"],
    ["/work/vectorcraft", "test", "--locked", "-p", "vectorcraft-pdf", "words_set_apart_by_spaces_tracked_past_an_em_keep_their_place"],
    ["/work/libs", "test", "--locked", "-p", "craft-pdf", "--features", "write,interpret", "--test", "print_color"]
  ]
}
